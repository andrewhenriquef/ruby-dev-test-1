# Ignore Mac and Linux system files
.DS_Store
.DS_Store?

# Ignore dotenv files
.env*

# Ignore uploaded files in development
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore pidfiles, but keep the directory
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep


# Ignore all logfiles and tempfiles
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore master key for decrypting credentials and more
/config/master.key
/config/credentials/*
!/config/credentials/.keep

/coverage/*